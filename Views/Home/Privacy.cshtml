@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="privacy-container">
    <div class="privacy-box">
        <h1 class="privacy-title">@ViewData["Title"]</h1>
        <p class="privacy-text">
            Use this page to detail your site's privacy policy. This might include what data you collect,
            how it's stored, and how users can request changes or deletion.
        </p>
    </div>
</div>
